generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RepositoryStatus {
  QUEUED
  CLONING
  PARSING
  CHUNKING
  EMBEDDING
  READY
  FAILED
}

model Repository {
  id         String           @id @default(cuid())
  githubUrl  String
  name       String?
  owner      String?
  branch     String?

  status     RepositoryStatus @default(QUEUED)

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}